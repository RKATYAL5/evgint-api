PORT=8787
CAREERS_APP_ORIGIN=http://127.0.0.1:4174

HR_EMAIL=HR@evgint.com
CAREERS_ADMIN_EMAIL=hr-admin@evgint.com
CAREERS_ADMIN_PASSWORD=ChangeMeNow!

# Optional: separate addresses for contact form and hackathon enrollment
# notifications. If left unset, both fall back to HR_EMAIL.
CONTACT_EMAIL=info@evgint.com
HACKATHON_EMAIL=hackathon@evgint.com

# --- Email delivery: configure ONE of the two options below ---

# Option A: Hostinger email (SMTP) - recommended if your domain's email
# is hosted with Hostinger. Create a mailbox in hPanel -> Emails first
# (e.g. careers@evgint.com), then use its address/password below.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Evergreen International <careers@evgint.com>

# Option B: Resend (https://resend.com) - only used if SMTP_HOST is empty
# and RESEND_API_KEY is set. Resend takes priority if both are configured.
RESEND_API_KEY=
RESEND_FROM=Evergreen International <careers@yourdomain.com>
